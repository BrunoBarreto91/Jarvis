{
  "app": "npx ts-node --prefer-ts-exts bin/jarvis.ts",
  "watch": {
    "include": ["**"],
    "exclude": [
      "README.md",
      "cdk*.json",
      "**/*.d.ts",
      "**/*.js",
      "tsconfig.json",
      "package*.json",
      "yarn.lock",
      "node_modules"
    ]
  },
  "context": {
    "@aws-cdk/aws-ec2:restrictDefaultSecurityGroup": false,
    "@aws-cdk/core:enablePartitionLiterals": true,
    "@aws-cdk/core:newStyleStackSynthesis": false
  }
}
